rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth()   { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }

    // Πεδία που ΑΛΛΑΖΕΙ αυτό το write (μόνο για updates).
    function touched() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyTouched(keys) { return touched().hasOnly(keys); }
    function touchesAny(keys)  { return touched().hasAny(keys); }

    // Σημαίες moderation — τις γράφει ΜΟΝΟ το onReportCreated (admin). Ούτε ο
    // συντάκτης δεν ξεκρύβει περιεχόμενο που κρύφτηκε από reports.
    function moderationFlags() {
      return ['reportCount', 'isReported', 'isHidden', 'hiddenReason'];
    }

    // Μοναδική αλλαγή σε λίστα uids = το uid του ίδιου του χρήστη (add ή remove).
    // Χρησιμοποιείται σε likes: δεν μπορείς να σβήσεις/βάλεις likes άλλων.
    function selfOnlyListDiff(field) {
      return request.resource.data[field].toSet()
               .difference(resource.data.get(field, []).toSet())
               .hasOnly([request.auth.uid])
          && resource.data.get(field, []).toSet()
               .difference(request.resource.data[field].toSet())
               .hasOnly([request.auth.uid]);
    }

    // ── USERS ─────────────────────────────────────────────────────────────
    // ΔΗΜΟΣΙΟ προφίλ (όνομα, avatar, rating, friends, blockedUids…). Κάθε
    // συνδεδεμένος χρήστης το διαβάζει — το χρειάζονται search / inbox /
    // αγγελίες. Τα ΕΥΑΙΣΘΗΤΑ (email, phone, fcmToken, language) ΔΕΝ ζουν εδώ:
    // βρίσκονται στο users/{uid}/private/data, το οποίο διαβάζει μόνο ο ίδιος.
    // Το Firestore δεν φιλτράρει πεδία στο read — γι' αυτό ο διαχωρισμός.
    match /users/{uid} {
      // Γράφονται ΜΟΝΟ server-side (Cloud Functions με admin → bypass rules):
      //  - rating/ratingCount/dealsCount: onDealUpdate
      //  - reportCount/isReported:        onReportCreated
      //  - friends: onFriendRequestAccepted / unfriendUser
      function serverManaged() {
        return ['rating', 'ratingCount', 'dealsCount', 'reportCount', 'isReported',
                'friends'];
      }

      // ΑΜΕΤΑΒΛΗΤΑ μετά τη δημιουργία. Το `createdAt` είναι σήμα εμπιστοσύνης
      // (ηλικία λογαριασμού) — χωρίς αυτό, ένας νέος λογαριασμός δηλώνει ότι
      // υπάρχει από το 2019. Τα `ageVerified`/`termsAcceptedAt` είναι το ΝΟΜΙΚΟ
      // αρχείο συγκατάθεσης (18+ και όροι, GDPR): αν ο χρήστης μπορεί να τα
      // ξαναγράψει, δεν αποδεικνύουν τίποτα.
      //
      // ΑΣΦΑΛΕΣ: και οι τρεις ροές εγγραφής τα γράφουν ΜΟΝΟ σε νέο doc —
      // auth_repository.dart:300 (`if (!hadDocBefore)`) και login_screen.dart:340
      // (`.set()` σε νέο χρήστη). Καμία ροή ενημέρωσης δεν τα ακουμπά.
      function immutableAfterCreate() {
        return ['createdAt', 'termsAcceptedAt', 'ageVerified'];
      }

      // Ευαίσθητα PII δεν ζουν ΠΟΤΕ στο δημόσιο doc (το διαβάζει κάθε χρήστης —
      // search/inbox/αγγελίες). Ζουν στο users/{uid}/private/data. Όλες οι ροές
      // του client (register, Google sign-in, complete/edit profile, FCM) ήδη τα
      // γράφουν μόνο εκεί· αυτός ο κανόνας εμποδίζει έναν ΤΡΟΠΟΠΟΙΗΜΕΝΟ client να
      // γράψει π.χ. το τηλέφωνο θύματος σε πεδίο ορατό σε όλους (doxxing).
      function publicPII() { return ['email', 'phone', 'fcmToken']; }

      allow read: if isAuth();

      // ── ΓΝΗΣΙΟ phoneVerified (ΕΝΕΡΓΟ) ────────────────────────────────────
      // Το `phoneVerified: true` το γράφει ο client. Χωρίς αυτόν τον κανόνα,
      // ένας τροποποιημένος client δηλωνόταν «επαληθευμένος» ΧΩΡΙΣ ποτέ να
      // λάβει SMS — παρακάμπτοντας την υποχρεωτική πύλη κινητού και παίρνοντας
      // το σήμα εμπιστοσύνης που βλέπουν οι άλλοι χρήστες πριν συναλλαχθούν.
      //
      // Η απόδειξη ότι πέρασε OTP δεν μπορεί να έρθει από τον client: έρχεται
      // από το ίδιο το Auth token, που το υπογράφει το Firebase. Ο μόνος τρόπος
      // να αποκτήσει κανείς το claim `phone_number` είναι να ολοκληρώσει OTP.
      //
      // ΠΡΟΫΠΟΘΕΣΗ: ο client πρέπει να κάνει `getIdToken(true)` ΠΡΙΝ το write,
      // αλλιώς το token είναι ακόμα το παλιό (χωρίς το claim) και το write
      // απορρίπτεται. Και τα δύο σημεία που γράφουν phoneVerified το κάνουν:
      //   - lib/features/auth/data/auth_repository.dart:186
      //   - lib/features/profile/presentation/change_phone_screen.dart:226
      // Τεστ: firestore-tests/phone.test.mjs
      //
      // ΣΤΗ ΔΗΜΙΟΥΡΓΙΑ: δεν φυτεύεις phoneVerified:true χωρίς OTP.
      function phoneVerifiedGenuineOnCreate() {
        return request.resource.data.get('phoneVerified', false) == false
            || request.auth.token.get('phone_number', '') != '';
      }
      //
      // ΣΤΟ UPDATE: ο έλεγχος ισχύει ΜΟΝΟ όταν ΑΓΓΙΖΕΙΣ το phoneVerified.
      // ΚΡΙΣΙΜΟ: το `request.resource.data` είναι ΟΛΟΚΛΗΡΟ το τελικό doc. Αν
      // ελέγχαμε σκέτα την τιμή του, τότε ένας ήδη επαληθευμένος χρήστης
      // (phoneVerified:true) θα χρειαζόταν το claim σε ΚΑΘΕ άσχετο write —
      // αλλαγή ονόματος, block, αποθήκευση αγγελίας, online status. Αν το claim
      // έλειπε για οποιονδήποτε λόγο, θα κλεινόταν ΜΟΝΙΜΑ έξω από το προφίλ του.
      // Η ασφάλεια είναι ίδια: το phoneVerified ΔΕΝ γίνεται true χωρίς OTP.
      function phoneVerifiedGenuineOnUpdate() {
        return !touched().hasAny(['phoneVerified'])
            || request.resource.data.get('phoneVerified', false) == false
            || request.auth.token.get('phone_number', '') != '';
      }

      // ── ΓΕΦΥΡΑ ΣΥΜΒΑΤΟΤΗΤΑΣ (προσωρινή) ──────────────────────────────────
      // Οι ΠΑΛΙΕΣ εκδόσεις γράφουν email/phone/fcmToken/language στο δημόσιο
      // doc. Αν το απαγορεύσουμε, το write απορρίπτεται ΟΛΟΚΛΗΡΟ και σπάνε το
      // Google sign-in και η εγγραφή. Τα δεχόμαστε λοιπόν, και το Cloud
      // Function `stripSensitiveFromUserDoc` τα μεταφέρει αμέσως στο private
      // doc και τα σβήνει από εδώ (~1 δευτ. έκθεση αντί για μόνιμη).
      // ΝΑ ΞΑΝΑΚΛΕΙΔΩΣΕΙ όταν όλοι οι χρήστες είναι σε έκδοση ≥ 1.0.3.
      allow create: if isOwner(uid)
                    && !request.resource.data.keys().hasAny(['reportCount', 'isReported'])
                    && !request.resource.data.keys().hasAny(publicPII())
                    && request.resource.data.get('rating', 0) <= 0
                    && request.resource.data.get('ratingCount', 0) <= 0
                    && request.resource.data.get('dealsCount', 0) <= 0
                    && request.resource.data.get('friends', []).size() == 0
                    && phoneVerifiedGenuineOnCreate();

      // ΜΟΝΟ ο ίδιος, και ποτέ τα server-managed πεδία. Κανείς δεν γράφει στο
      // doc άλλου χρήστη — ούτε στο `friends`. (Οι ΠΑΛΙΕΣ εκδόσεις το έκαναν
      // στην αποδοχή φιλίας· εκεί το write θα αποτυγχάνει μέχρι να ενημερωθούν.
      // Το εναλλακτικό —να επιτραπεί— σημαίνει ότι οποιοσδήποτε μπορεί να
      // αυτοπροστεθεί στη λίστα φίλων σου και να δει ιδιωτικό προφίλ.)
      allow update: if isOwner(uid)
                    && !touchesAny(serverManaged())
                    && !touchesAny(publicPII())
                    && !touchesAny(immutableAfterCreate())
                    && phoneVerifiedGenuineOnUpdate();
      // delete: ΜΟΝΟ server (deleteUserAccount).

      // Ευαίσθητα δεδομένα — ούτε διαβάζονται ούτε γράφονται από άλλον χρήστη.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── FRIEND REQUESTS ───────────────────────────────────────────────────
    match /friendRequests/{reqId} {
      function isPeer() {
        return resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid;
      }

      allow read:   if isAuth() && isPeer();
      allow create: if isAuth()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending';
      // ΜΟΝΟ ο παραλήπτης απαντά, και μόνο σε pending αίτημα. Το 'accepted'
      // πυροδοτεί το Cloud Function που γράφει τα friends και στα δύο προφίλ —
      // γι' αυτό ο αποστολέας δεν επιτρέπεται να «αποδεχτεί» ο ίδιος.
      allow update: if isAuth()
                    && resource.data.toUid == request.auth.uid
                    && resource.data.status == 'pending'
                    && onlyTouched(['status', 'respondedAt'])
                    && request.resource.data.status in ['accepted', 'rejected'];
      allow delete: if isAuth() && isPeer();
    }

    // ── LISTINGS ──────────────────────────────────────────────────────────
    match /listings/{id} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      // Ο κάτοχος επεξεργάζεται, αλλά ΔΕΝ ξεκρύβει/μηδενίζει αγγελία που
      // κρύφτηκε από reports (τα γράφει το onReportCreated).
      //
      // ΤΟ `userId` ΕΙΝΑΙ ΑΜΕΤΑΒΛΗΤΟ. Ο έλεγχος ιδιοκτησίας κοιτούσε μόνο το
      // ΠΑΛΙΟ doc (`resource.data.userId`), οπότε ο κάτοχος μπορούσε να γράψει
      // ΝΕΟ `userId` και να μεταβιβάσει την αγγελία σε ανυποψίαστο χρήστη:
      // φτιάχνεις αγγελία με παράνομο περιεχόμενο και μετά την «περνάς» στο θύμα.
      // Το listing_card.dart:131 δείχνει τον κάτοχο κάνοντας stream το
      // users/{listing.userId} → το όνομα, η φωτογραφία και η βαθμολογία του
      // θύματος κολλάνε πάνω στο περιεχόμενο του επιτιθέμενου, και τα reports
      // πέφτουν σε αυτόν.
      allow update: if isAuth() && resource.data.userId == request.auth.uid
                    && !touchesAny(moderationFlags())
                    && !touchesAny(['userId']);
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── CHATS ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      function isParticipant() { return request.auth.uid in resource.data.participants; }
      function chatOf()   { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
      function chatLives(){ return exists(/databases/$(database)/documents/chats/$(chatId)); }
      function inChat()   { return request.auth.uid in chatOf().participants; }
      function blockedBetweenPeers() {
        return request.auth.uid in get(/databases/$(database)/documents/users/$(chatOf().participants[0])).data.get('blockedUids', [])
            || request.auth.uid in get(/databases/$(database)/documents/users/$(chatOf().participants[1])).data.get('blockedUids', []);
      }

      allow read:   if isAuth() && isParticipant();
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      // ΚΡΙΣΙΜΟ: το `participants` δεν αλλάζει ΠΟΤΕ μετά τη δημιουργία. Χωρίς
      // αυτόν τον περιορισμό ένας συμμετέχων θα μπορούσε να προσθέσει τρίτον
      // και να του δώσει ολόκληρο το ιστορικό της συνομιλίας.
      allow update: if isAuth() && isParticipant()
                    && onlyTouched(['lastMessage', 'lastMessageAt', 'lastSenderId',
                                    'unread', 'typingUids', 'mutedBy'])
                    // Η ΠΡΟΕΠΙΣΚΟΠΗΣΗ ΤΟΥ INBOX ΔΕΝ ΠΛΑΣΤΟΓΡΑΦΕΙΤΑΙ.
                    //
                    // Το `lastMessage` είναι ό,τι βλέπει ο άλλος στο inbox, και
                    // γραφόταν ελεύθερα από τον συνομιλητή — χωρίς να υπάρχει
                    // αντίστοιχο μήνυμα στη συνομιλία. Δηλαδή έστελνες «Ο
                    // λογαριασμός σου: πάτα εδώ…» ως προεπισκόπηση, και όταν ο
                    // άλλος άνοιγε το chat δεν υπήρχε τίποτα — κλασικό phishing
                    // χωρίς ίχνη. Τώρα, όποιος αλλάζει την προεπισκόπηση πρέπει
                    // να δηλωθεί και ως αποστολέας της.
                    //
                    // Όλες οι ροές του client γράφουν lastMessage + lastSenderId
                    // μαζί (chat_repository.dart:55, :81, :115, :143), οπότε δεν
                    // επηρεάζονται. Τα unread/typing/mute δεν αγγίζουν κανένα
                    // από τα δύο και συνεχίζουν κανονικά.
                    && (!touchesAny(['lastMessage', 'lastSenderId'])
                        || request.resource.data.lastSenderId == request.auth.uid);
      allow delete: if isAuth() && isParticipant();

      match /messages/{msgId} {
        allow read:   if isAuth() && inChat();
        allow create: if isAuth() && inChat()
                      && request.resource.data.senderId == request.auth.uid
                      && !blockedBetweenPeers();
        // (α) read receipts / reactions — κάθε συμμετέχων, αλλά στο reactions
        //     μόνο το ΔΙΚΟ του κλειδί. (β) edit κειμένου μόνο ο αποστολέας.
        allow update: if isAuth() && inChat()
                      && (
                        (onlyTouched(['readBy', 'reactions'])
                          && (!('reactions' in touched())
                              || request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])))
                        || (resource.data.senderId == request.auth.uid
                            && onlyTouched(['text', 'editedAt']))
                        // (γ) ΔΙΑΓΡΑΦΗ ΜΗΝΥΜΑΤΟΣ (soft): μόνο ο αποστολέας, και
                        //     μόνο προς τα εμπρός — δεν «ξε-διαγράφεται» ώστε να
                        //     μη μπορεί κάποιος να επαναφέρει περιεχόμενο που
                        //     ο άλλος είδε ως διαγραμμένο. Το μήνυμα μένει στη
                        //     ροή ως «Το μήνυμα διαγράφηκε».
                        || (resource.data.senderId == request.auth.uid
                            && onlyTouched(['isDeleted', 'deletedAt', 'text', 'mediaUrl'])
                            && request.resource.data.isDeleted == true)
                      );
        // Σβήνεις ΜΟΝΟ δικά σου μηνύματα. Εξαίρεση: το «διαγραφή συνομιλίας»
        // σβήνει πρώτα το chat doc και μετά τα μηνύματα — τα ορφανά μηνύματα
        // (chat που δεν υπάρχει πια) καθαρίζονται ελεύθερα.
        allow delete: if isAuth()
                      && (
                        (chatLives() && inChat()
                          && resource.data.senderId == request.auth.uid)
                        || !chatLives()
                      );
      }
    }

    // ── DEALS ─────────────────────────────────────────────────────────────
    // `participants: [user1Uid, user2Uid]` — υπάρχει ώστε τα queries να μπορούν
    // να περιοριστούν στους συμμετέχοντες (τα rules ΔΕΝ φιλτράρουν: ένα query
    // χωρίς τον περιορισμό απορρίπτεται ολόκληρο).
    match /deals/{id} {
      function isPeer() { return request.auth.uid in resource.data.participants; }

      // Το `|| user1Uid/user2Uid` είναι ΓΕΦΥΡΑ για τις παλιές εκδόσεις, που
      // κάνουν query με user1Uid/user2Uid αντί για `participants`. Ίδια
      // ασφάλεια (και τα τρία δηλώνουν συμμετέχοντα) — να αφαιρεθεί όταν όλοι
      // είναι σε έκδοση ≥ 1.0.3.
      function isLegacyPeer() {
        return resource.data.user1Uid == request.auth.uid
            || resource.data.user2Uid == request.auth.uid;
      }

      // Ο δημιουργός πρέπει να είναι ένας από τους δύο συμμετέχοντες — είτε το
      // δηλώσει με `participants` (νέα έκδοση) είτε με user1Uid/user2Uid
      // (παλιά έκδοση· το `participants` το συμπληρώνει το migration/trigger).
      function creatorIsPeer() {
        return request.auth.uid == request.resource.data.user1Uid
            || request.auth.uid == request.resource.data.user2Uid;
      }

      // Έγκυρη εγγραφή rating από συμμετέχοντα:
      //  - ownerRating: το γράφει ΜΟΝΟ ο user1 (βαθμολογεί τον user2).
      //  - seekerRating: το γράφει ΜΟΝΟ ο user2 (βαθμολογεί τον user1).
      // Έτσι κανείς δεν βαθμολογεί τον εαυτό του. Επιπλέον: τιμή 1–5, deal
      // ΟΛΟΚΛΗΡΩΜΕΝΟ, και μόνο μία φορά (null → value). Χωρίς αυτούς τους
      // ελέγχους ένας παρακαμμένος client έγραφε seekerRating:1000000 στον
      // εαυτό του και εκτόξευε το rating του προφίλ του.
      //
      // ΚΡΙΣΙΜΟ: δέχεται ΚΑΙ float. Ο Dart client στέλνει `double rating`
      // (deal_repository.rate → 5.0), που το Firestore αποθηκεύει ως double.
      // Ένα σκέτο `v is int` απέρριπτε ΚΑΘΕ αξιολόγηση με permission-denied
      // (και τα rating/ratingCount έμεναν μόνιμα 0). Το εύρος 1–5 είναι που
      // μπλοκάρει την κατάχρηση — όχι ο τύπος.
      function ratingInRange(v) {
        return (v is int || v is float) && v >= 1 && v <= 5;
      }
      function validRatingWrite() {
        return (onlyTouched(['ownerRating'])
                  && request.auth.uid == resource.data.user1Uid
                  && resource.data.get('ownerRating', null) == null
                  && ratingInRange(request.resource.data.ownerRating)
                  && resource.data.status == 'completed')
            || (onlyTouched(['seekerRating'])
                  && request.auth.uid == resource.data.user2Uid
                  && resource.data.get('seekerRating', null) == null
                  && ratingInRange(request.resource.data.seekerRating)
                  && resource.data.status == 'completed');
      }

      allow read:   if isAuth() && (isPeer() || isLegacyPeer());
      allow create: if isAuth()
                    && creatorIsPeer()
                    && request.resource.data.status == 'pending'
                    // Χωρίς αυτό, φτιάχνεις deal με τον εαυτό σου (participants
                    // [self, self]) και μετά βαθμολογείς τον εαυτό σου — χωρίς θύμα.
                    && request.resource.data.user1Uid != request.resource.data.user2Uid
                    // Δεν φυτεύεις rating κατά τη δημιουργία.
                    // ΠΡΟΣΟΧΗ: ελέγχουμε την ΤΙΜΗ, όχι την ύπαρξη του κλειδιού.
                    // Ο client δημιουργεί το deal με `ownerRating: null` και
                    // `seekerRating: null` (deal_repository.dart) — το `keys()`
                    // τα μετράει κι αυτά, οπότε ένα `hasAny` θα μπλόκαρε ΚΑΘΕ
                    // νόμιμη δημιουργία deal με permission-denied.
                    && request.resource.data.get('ownerRating', null) == null
                    && request.resource.data.get('seekerRating', null) == null
                    && (!('participants' in request.resource.data)
                        || (request.resource.data.participants.size() == 2
                            && request.resource.data.participants.hasOnly(
                                 [request.resource.data.user1Uid,
                                  request.resource.data.user2Uid])));
      allow update: if isAuth() && (isPeer() || isLegacyPeer())
                    && !touchesAny(['participants', 'user1Uid', 'user2Uid', 'chatId'])
                    && (
                      // Είτε έγκυρη βαθμολογία…
                      validRatingWrite()
                      // …είτε μη-rating ενημέρωση (πρόταση/αποδοχή/ακύρωση).
                      || (
                        !touchesAny(['ownerRating', 'seekerRating'])
                        // Ένα ΟΛΟΚΛΗΡΩΜΕΝΟ deal είναι κλειδωμένο για τον client:
                        // καμία μη-rating αλλαγή. Αλλιώς θα το γύριζε πίσω σε
                        // active και θα διπλομετρούσε το dealsCount στο επόμενο
                        // completion.
                        && resource.data.status != 'completed'
                        // Η ΟΛΟΚΛΗΡΩΣΗ είναι αποκλειστικά server-side (λήξη
                        // countdown / scheduler). Ο client δεν κατασκευάζει
                        // «ολοκληρωμένα» deals για να φουσκώσει το dealsCount.
                        && request.resource.data.status != 'completed'
                        // Ακύρωση μόνο όσο είναι pending.
                        && (request.resource.data.status != 'cancelled'
                            || resource.data.status == 'pending')
                        // ── ΑΠΟΔΟΧΗ ΜΟΝΟ ΑΠΟ ΤΟΝ ΠΑΡΑΛΗΠΤΗ ──────────────────
                        // Ο user1 στέλνει την πρόταση (proposal1), ο user2 την
                        // αποδέχεται. Χωρίς αυτόν τον έλεγχο ο ΙΔΙΟΣ ο προτείνων
                        // μπορούσε να γυρίσει το deal σε `active` — δηλαδή να
                        // αποδεχτεί τη δική του πρόταση — και το onDealUpdate
                        // έφτιαχνε wall post «deal ολοκληρώθηκε» ΚΑΙ στον τοίχο
                        // του άλλου, χωρίς εκείνος να συμφωνήσει ποτέ.
                        //
                        // Ο έλεγχος αφορά ΜΟΝΟ τη μετάβαση: αν το status δεν
                        // αλλάζει, ο user1 συνεχίζει να ενημερώνει κανονικά ένα
                        // ήδη active deal (π.χ. proposal fields).
                        && (!touchesAny(['status'])
                            || request.resource.data.status != 'active'
                            || request.auth.uid == resource.data.user2Uid)
                      )
                    );
      allow delete: if isAuth() && (isPeer() || isLegacyPeer());
    }

    // ── WALL POSTS ────────────────────────────────────────────────────────
    match /wallPosts/{id} {
      allow read:   if isAuth();

      // ΔΗΜΙΟΥΡΓΙΑ: ΜΟΝΟ server (onDealUpdate → createDealWallPost, admin SDK).
      //
      // Ο παλιός κανόνας ζητούσε μόνο `authorUid == auth.uid` και άφηνε ΟΛΑ τα
      // υπόλοιπα πεδία ελεύθερα — μαζί με το `targetUid`, που καθορίζει σε ΠΟΙΟΥ
      // τον τοίχο εμφανίζεται το post (wall_post_repository.dart:16 κάνει query
      // `where('targetUid','==',uid)`). Οποιοσδήποτε χρήστης μπορούσε λοιπόν να
      // φυτέψει στο προφίλ ΟΠΟΙΟΥΔΗΠΟΤΕ ένα ψεύτικο «deal ολοκληρώθηκε» με
      // αυθαίρετο κείμενο — και το θύμα ΔΕΝ μπορούσε να το σβήσει, γιατί το
      // delete απαιτεί `authorUid == auth.uid`, δηλαδή τον επιτιθέμενο.
      //
      // Ο client ΔΕΝ δημιουργεί ποτέ wall posts (επαληθεύτηκε: καμία .add()/.set()
      // στο lib/ — βλ. deal_repository.dart:90-93). Άρα η άρνηση δεν σπάει τίποτα.
      allow create: if false;

      // Ο συντάκτης επεξεργάζεται. Οποιοσδήποτε άλλος: μόνο το ΔΙΚΟ του like ή
      // ο μετρητής σχολίων (±1) — δεν σβήνει τα likes των άλλων.
      allow update: if isAuth() && (
                      (resource.data.authorUid == request.auth.uid
                        && !touchesAny(moderationFlags())
                        // Το post δεν αλλάζει ιδιοκτήτη ούτε τοίχο.
                        && !touchesAny(['authorUid', 'targetUid', 'dealId']))
                      || (onlyTouched(['likes']) && selfOnlyListDiff('likes'))
                      || (onlyTouched(['commentsCount'])
                          && (request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
                              || request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1))
                    );
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;

      match /comments/{cid} {
        allow read:   if isAuth();
        allow create: if isAuth() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAuth() && (
                        (resource.data.authorUid == request.auth.uid
                        && !touchesAny(moderationFlags())
                        // Το σχόλιο δεν αλλάζει συντάκτη (βλ. σχόλιο στα listings).
                        && !touchesAny(['authorUid']))
                        || (onlyTouched(['likes']) && selfOnlyListDiff('likes'))
                        || onlyTouched(['reactions'])
                      );
        allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
      }
    }

    // ── USER POSTS ────────────────────────────────────────────────────────
    match /userPosts/{id} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuth() && (
                      (resource.data.authorUid == request.auth.uid
                        && !touchesAny(moderationFlags())
                        // Το post δεν αλλάζει συντάκτη (βλ. σχόλιο στα listings).
                        && !touchesAny(['authorUid']))
                      || (onlyTouched(['likes']) && selfOnlyListDiff('likes'))
                      || (onlyTouched(['commentsCount'])
                          && (request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
                              || request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1))
                    );
      allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;

      match /comments/{cid} {
        allow read:   if isAuth();
        allow create: if isAuth() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAuth() && (
                        (resource.data.authorUid == request.auth.uid
                        && !touchesAny(moderationFlags())
                        // Το σχόλιο δεν αλλάζει συντάκτη (βλ. σχόλιο στα listings).
                        && !touchesAny(['authorUid']))
                        || (onlyTouched(['likes']) && selfOnlyListDiff('likes'))
                        || onlyTouched(['reactions'])
                      );
        allow delete: if isAuth() && resource.data.authorUid == request.auth.uid;
      }
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────
    // ΚΡΙΣΙΜΟ: κάθε doc εδώ γίνεται push μέσω του onNewNotification. Αν ο client
    // μπορούσε να δημιουργήσει doc, οποιοσδήποτε θα έστελνε push με αυθαίρετο
    // κείμενο σε οποιονδήποτε (phishing). Δημιουργία/διαγραφή: ΜΟΝΟ server.
    match /notifications/{id} {
      allow read:   if isAuth() && resource.data.targetUid == request.auth.uid;
      allow update: if isAuth() && resource.data.targetUid == request.auth.uid
                    && onlyTouched(['isRead', 'read']);
    }

    // ── TAGS ──────────────────────────────────────────────────────────────
    // Trending counters: μόνο ±1 ανά write (δημιουργία/διαγραφή αγγελίας).
    // Χωρίς αυτό, οποιοσδήποτε έγραφε αυθαίρετο count ή έσβηνε tag.
    match /tags/{tag} {
      allow read:   if isAuth();
      allow create: if isAuth()
                    && request.resource.data.keys().hasOnly(['name', 'count', 'lastUsedAt'])
                    && request.resource.data.count == 1;
      allow update: if isAuth()
                    && onlyTouched(['name', 'count', 'lastUsedAt'])
                    && (request.resource.data.count == resource.data.count + 1
                        || request.resource.data.count == resource.data.count - 1);
      // delete: ποτέ από client.
    }

    // ── REPORTS ───────────────────────────────────────────────────────────
    match /reports/{id} {
      allow create: if isAuth() && request.resource.data.reporterUid == request.auth.uid;
      // Ο καταγγέλλων διαβάζει μόνο τα δικά του (client-side dedup).
      allow read:   if isAuth() && resource.data.reporterUid == request.auth.uid;
    }
  }
}
