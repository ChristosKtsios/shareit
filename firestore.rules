rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()          { return request.auth != null; }
    function isOwner(uid)      { return request.auth.uid == uid; }
    function isParticipant()   { return request.auth.uid in resource.data.participants; }
    function notBlocked(uid)   { return !(request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.blockedUids); }

    // Users
    match /users/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
    }

    // Listings
    match /listings/{id} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (resource.data.userId == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReported']));
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Chats
    match /chats/{chatId} {
      allow read, update: if isAuth() && isParticipant();
      allow create:       if isAuth();
      match /messages/{msgId} {
        allow read:   if isAuth() && isParticipant();
        allow create: if isAuth() && isParticipant() && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Deals
    match /deals/{id} {
      allow read:   if isAuth() && (resource.data.ownerUid == request.auth.uid || resource.data.seekerUid == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.ownerUid == request.auth.uid || resource.data.seekerUid == request.auth.uid);
    }

    // Wall posts
    match /wallPosts/{id} {
      allow read:  if isAuth();
      allow create: if isAuth() && request.resource.data.authorUid == request.auth.uid;
      match /comments/{cid} {
        allow read:   if isAuth();
        allow create: if isAuth();
      }
    }

    // Notifications — μόνο ο παραλήπτης
    match /notifications/{id} {
      allow read, update: if isAuth() && resource.data.targetUid == request.auth.uid;
      allow create:       if isAuth();
    }

    // Reports — write only
    match /reports/{id} {
      allow create: if isAuth() && request.resource.data.reporterUid == request.auth.uid;
      allow read:   if false;
    }
  }
}
