rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth()      { return request.auth != null; }
    function isOwner(uid)  { return isAuth() && request.auth.uid == uid; }

    // Uploads must be an image or video and under 100 MB.
    //
    // Το contentType ΠΡΕΠΕΙ να είναι εικόνα/βίντεο. Πριν, ο κανόνας δεχόταν
    // `contentType == null`, οπότε ένας client που απλώς παρέλειπε τον header
    // ανέβαζε ΟΠΟΙΟΔΗΠΟΤΕ αρχείο (HTML, script, binary) έως 100 MB σε δημόσια
    // αναγνώσιμη διαδρομή — φιλοξενία αυθαίρετου περιεχομένου με κόστος δικό μας.
    // ΠΡΟΣΟΧΗ: στο ANDROID το `putFile` ΔΕΝ συμπεραίνει contentType από την
    // κατάληξη — ο SDK βάζει `application/octet-stream`. Γι' αυτό ΚΑΘΕ upload
    // στον client περνά ΡΗΤΟ `SettableMetadata(contentType: ...)`. Αν προστεθεί
    // νέο upload, ΠΡΕΠΕΙ να κάνει το ίδιο, αλλιώς θα κόβεται εδώ.
    function isValidMedia() {
      return request.resource.size < 100 * 1024 * 1024
             && request.resource.contentType != null
             && request.resource.contentType.matches('(image|video)/.*');
    }

    // Participants of a chat, read from the corresponding Firestore document.
    function chatParticipants(chatId) {
      return firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }

    // Profile photos & avatars — /users/{uid}/...
    match /users/{uid}/{allPaths=**} {
      allow read:   if isAuth();
      allow write:  if isOwner(uid) && isValidMedia();
      allow delete: if isOwner(uid);
    }

    // Listing images — /listings/{uid}/...
    match /listings/{uid}/{allPaths=**} {
      allow read:   if isAuth();
      allow write:  if isOwner(uid) && isValidMedia();
      allow delete: if isOwner(uid);
    }

    // User post media — /userPosts/{uid}/...
    match /userPosts/{uid}/{allPaths=**} {
      allow read:   if isAuth();
      allow write:  if isOwner(uid) && isValidMedia();
      allow delete: if isOwner(uid);
    }

    // Chat media — /chats/{chatId}/... — restricted to chat participants.
    match /chats/{chatId}/{allPaths=**} {
      allow read:   if isAuth() && request.auth.uid in chatParticipants(chatId);
      allow write:  if isAuth() && request.auth.uid in chatParticipants(chatId) && isValidMedia();
      allow delete: if isAuth() && request.auth.uid in chatParticipants(chatId);
    }

    // Wall post comment images — /wallComments/{postId}/...
    //
    // Η διαδρομή ΔΕΝ περιέχει uid, οπότε δεν μπορούμε να ταυτοποιήσουμε τον
    // ιδιοκτήτη του αρχείου. Πριν, οποιοσδήποτε συνδεδεμένος μπορούσε να
    // ΑΝΤΙΚΑΤΑΣΤΗΣΕΙ ή να ΣΒΗΣΕΙ την εικόνα σχολίου οποιουδήποτε άλλου —
    // ακόμα και να τη γυρίσει σε άλλο περιεχόμενο.
    //
    // Λύση: μόνο ΔΗΜΙΟΥΡΓΙΑ νέου αρχείου (resource == null → δεν υπάρχει ήδη).
    // Καμία αντικατάσταση, καμία διαγραφή από τον client.
    match /wallComments/{postId}/{allPaths=**} {
      allow read:   if isAuth();
      allow create: if isAuth() && isValidMedia() && resource == null;
      // update/delete: ποτέ από client.
    }

    // Any path not matched above is denied by default.
  }
}
